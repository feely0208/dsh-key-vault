{
  "name": "@deepwhale-cn/dsh-key-vault",
  "version": "0.1.0",
  "description": "深鲸 Key 保险箱：本机保存你自带的多个 API Key（只显示掩码、0600 权限、不上传）",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh","dsh-plugin","deepseek-harness","plugin","skill","key-vault","api-key","secrets","凭据"],
  "files": ["lib","bin","skill","cordis.patch.yml","README.md","LICENSE"],
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "bin": { "dsh-key-vault": "./bin/cli.mjs" },
  "engines": { "dsh": ">=0.1.0-rc.6 <0.3.0", "node": ">=18" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web", "immediately": true }
  },
  "dependencies": { "@deepwhale-cn/dsh-guard-core": "^0.10.1" },
  "peerDependencies": { "@deepseek-ai/dsh-skill": "*" },
  "repository": { "type": "git", "url": "git+https://github.com/feely0208/dsh-key-vault.git" },
  "homepage": "https://www.deepwhale.org.cn/skills.html",
  "bugs": { "url": "https://github.com/feely0208/dsh-key-vault/issues" }
}
